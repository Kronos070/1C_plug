<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.ui.views">
      <category
            id="com.example.edtai"
            name="ПерУН">
      </category>
      <view
            id="com.example.edtai.view.chat"
            name="ПерУН"
            category="com.example.edtai"
            class="com.example.edtai.ui.ChatView"
            icon="icons/perun.png"
            restorable="true">
      </view>
   </extension>
   <extension point="org.eclipse.ui.perspectiveExtensions">
      <perspectiveExtension targetID="com._1c.g5.v8.dt.ui2.perspective">
         <view
               id="com.example.edtai.view.chat"
               relationship="right"
               relative="org.eclipse.ui.editorss"
               ratio="0.66"
               visible="true">
         </view>
         <viewShortcut id="com.example.edtai.view.chat"/>
      </perspectiveExtension>
   </extension>
   <extension point="org.eclipse.ui.preferencePages">
      <page
            id="com.example.edtai.preferences"
            name="ПерУН"
            class="com.example.edtai.ui.preferences.PerunPreferencePage">
      </page>
   </extension>
   <extension point="org.eclipse.ui.startup">
      <startup class="com.example.edtai.ui.layout.LayoutStartup">
      </startup>
   </extension>
   <extension point="org.eclipse.core.runtime.preferences">
      <initializer class="com.example.edtai.infrastructure.settings.PreferenceDefaults">
      </initializer>
   </extension>
   <extension point="org.eclipse.ui.commands">
      <command
            id="com.example.edtai.askCode"
            name="Спросить ПерУН о коде">
         <commandParameter
               id="com.example.edtai.codeAction"
               name="Действие"
               optional="false">
         </commandParameter>
      </command>
   </extension>
   <extension point="org.eclipse.ui.handlers">
      <handler
            commandId="com.example.edtai.askCode"
            class="com.example.edtai.ui.context.AskCodeHandler">
      </handler>
   </extension>
   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="popup:#BslEditorContext?after=additions">
         <menu id="com.example.edtai.menu.code.bsl" label="ПерУН" icon="icons/perun.png">
            <command
                  commandId="com.example.edtai.askCode"
                  label="Объяснить код"
                  style="push">
               <parameter name="com.example.edtai.codeAction" value="explain"/>
            </command>
            <command
                  commandId="com.example.edtai.askCode"
                  label="Сделать документацию"
                  style="push">
               <parameter name="com.example.edtai.codeAction" value="document"/>
            </command>
            <command
                  commandId="com.example.edtai.askCode"
                  label="Найти ошибки"
                  style="push">
               <parameter name="com.example.edtai.codeAction" value="review"/>
            </command>
            <command
                  commandId="com.example.edtai.askCode"
                  label="Улучшить код"
                  style="push">
               <parameter name="com.example.edtai.codeAction" value="refactor"/>
            </command>
         </menu>
      </menuContribution>
      <menuContribution locationURI="popup:#TextEditorContext?after=additions">
         <menu id="com.example.edtai.menu.code.text" label="ПерУН" icon="icons/perun.png">
            <command
                  commandId="com.example.edtai.askCode"
                  label="Объяснить код"
                  style="push">
               <parameter name="com.example.edtai.codeAction" value="explain"/>
            </command>
            <command
                  commandId="com.example.edtai.askCode"
                  label="Сделать документацию"
                  style="push">
               <parameter name="com.example.edtai.codeAction" value="document"/>
            </command>
            <command
                  commandId="com.example.edtai.askCode"
                  label="Найти ошибки"
                  style="push">
               <parameter name="com.example.edtai.codeAction" value="review"/>
            </command>
            <command
                  commandId="com.example.edtai.askCode"
                  label="Улучшить код"
                  style="push">
               <parameter name="com.example.edtai.codeAction" value="refactor"/>
            </command>
         </menu>
      </menuContribution>
   </extension>
</plugin>
